<?xml version="1.0" encoding="utf-8"?>
<!--
  REVIEW_NOTES C-5: cleartext HTTP is allowed ONLY for local-development hosts.
  Release production builds will refuse plaintext for any other host.

  - 10.0.2.2     : Android emulator's loopback to the dev machine
  - 127.0.0.1    : on-device localhost
  - 192.168.*    : the typical LAN range a phone uses to talk to the dev box
  - 10.0.0.0/8   : home LANs that use 10.x ranges (corporate / fancy routers)

  To talk to a production https endpoint you don't need to add anything — the
  default-config <cleartextTrafficPermitted>false</cleartextTrafficPermitted>
  already forces TLS.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain-pattern includeSubdomains="false">192.168.*.*</domain-pattern>
    <domain-pattern includeSubdomains="false">10.*.*.*</domain-pattern>
  </domain-config>
</network-security-config>
